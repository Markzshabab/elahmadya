{
  "rules": {
    ".read": false,
    ".write": false,

    "votes": {
      ".read": "auth != null",
      "$voteId": {
        ".write": false,
        ".validate": "!data.exists()"
      }
    },

    "votes_index": {
      ".read": false,
      ".write": false
    },

    "statistics": {
      "summary": { ".read": true, ".write": false },
      "daily": { ".read": "auth != null", ".write": false }
    },

    "media": {
      ".read": "auth != null",
      "$mediaId": { ".write": false }
    },

    "banned_ips": {
      ".read": "auth != null",
      ".write": false
    },

    "settings": {
      ".read": "auth != null",
      ".write": false
    },

    "logs": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
